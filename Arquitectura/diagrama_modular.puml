@startuml Diagrama_Modular
!theme plain
skinparam componentStyle rectangle
skinparam defaultFontName Verdana
skinparam defaultFontSize 12
skinparam padding 10
skinparam nodesep 80
skinparam ranksep 80

title Vista Modular - Sistema TFM

package "Recopilación" #LightCoral {
  component "Recopilador" as Recop
}

package "Procesamiento" #LightSalmon {
  component "Procesador" as Proc
}

package "Búsqueda" #LightGoldenRodYellow {
  component "Buscador" as Search
}

package "Evaluación" #LightCyan {
  component "Evaluador" as Eval
}

package "Presentación" #LightBlue {
  component "Backend API" as API
  component "Frontend" as UI
}

Recop --> Proc : Datos brutos
Proc --> Search : Índices
Search --> API : Resultados
Eval --> API : Análisis
API --> UI : JSON

@enduml

